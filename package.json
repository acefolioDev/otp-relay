{
  "name": "otp-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Muhammad Atif <dev.muhammad.atif@gmail.com>",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "REQUIRE_REDIS_TESTS=true vitest run tests/redis.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "provision": "node scripts/provision.mjs",
    "encrypt:example": "node scripts/encrypt-example.mjs",
    "load": "node scripts/load.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:android": "android/gradlew -p android testDebugUnitTest",
    "test:ios:live": "scripts/test-ios-client-live.sh"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

NODE_ENV=development
PORT=3000
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=otp-relay
# Generate the following two lines with npm run provision; see provisioning/server.env.
PAIRINGS_JSON=[]
METRICS_TOKEN_HASH=
OTP_TTL_SECONDS=90
CLOCK_SKEW_SECONDS=10
LOG_LEVEL=info
DEV_ALLOW_PLAINTEXT_OTP=false
RATE_LIMIT_ANDROID=120
RATE_LIMIT_IPHONE=600
MAX_LONG_POLLS=200
# Optional: PostgreSQL Database for Dynamic User Registration & Pairing
DATABASE_URL=postgresql://postgres:password@localhost:5432/otp_relay
# Optional: Comma-separated Google OAuth Web Client IDs to restrict token audience
GOOGLE_CLIENT_IDS=
